<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>OnlineSim.Api</RootNamespace>
    <AssemblyName>OnlineSim.Api</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package -->
    <PackageId>OnlineSim.Api</PackageId>
    <Version>1.0.1</Version>
    <Authors>s00d</Authors>
    <Description>Typed async client for the OnlineSim API (SMS numbers, rent, account, free numbers) with a built-in offline MockOnlineSim for tests. netstandard2.0 and net8.0: .NET Framework 4.6.2+, .NET 6/8/9+, Unity/Mono.</Description>
    <PackageTags>onlinesim;sms;sms-verification;virtual-number;otp;api-client;sdk</PackageTags>
    <PackageProjectUrl>https://s00d.github.io/onlinesim-dotnet-api/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/s00d/onlinesim-dotnet-api</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/s00d/onlinesim-dotnet-api/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <Copyright>Copyright (c) s00d</Copyright>

    <!-- Symbols and Source Link (built into the .NET 8+ SDK for GitHub repos) -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- In-box on net8.0; the only dependency, and only for netstandard2.0. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="OnlineSim.Api.Tests" />
  </ItemGroup>

  <!-- PackageReleaseNotes: the CHANGELOG section of this version. -->
  <Target Name="SetReleaseNotesFromChangelog" BeforeTargets="GenerateNuspec;_GetPackageFiles">
    <PropertyGroup>
      <_Changelog>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../CHANGELOG.md'))</_Changelog>
      <_ChangelogSection>$([System.Text.RegularExpressions.Regex]::Match($(_Changelog), '(?ms)^## $(Version)\r?\n(.*?)(?=^## |\z)').Groups[1].Value.Trim())</_ChangelogSection>
      <PackageReleaseNotes Condition="'$(_ChangelogSection)' != ''">$(_ChangelogSection)</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

</Project>
